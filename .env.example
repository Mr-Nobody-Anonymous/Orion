# ORION — example environment configuration
# Copy to `.env` and fill in only what you actually use.
# Nothing here is required: ORION runs fully offline without any of it.

# ---------------------------------------------------------------------------
# Cloud AI peers (PeerAICouncil / model council). Every provider whose key
# is present becomes consultable; missing keys are simply unavailable.
# Nothing here is required: ORION runs fully offline without any of it.
#
# Configure only what you use, then verify with:
#   python -m orion peers          # which peers are configured + models
#   python -m orion deliberate "test question"   # consult them live
# ---------------------------------------------------------------------------

# --- OpenRouter (one key, hundreds of models incl. FREE :free variants) ----
# Get a key: https://openrouter.ai/settings/keys
# Free models: browse https://openrouter.ai/models and filter "Pricing: FREE",
# then set OPENROUTER_MODEL to e.g. deepseek/deepseek-chat-v3.1:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   (default; override only for mirrors)

# --- DeepSeek direct (very cheap; chat + reasoner) ------------------------
# Get a key: https://platform.deepseek.com/api_keys
# deepseek-chat (V3) / deepseek-reasoner (R1)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1     (default; override only for mirrors)

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1        (default; override for gateways)

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Google Gemini ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Azure OpenAI ----------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Cohere / Mistral --------------------------------------------------------
COHERE_API_KEY=
MISTRAL_API_KEY=

# --- Any OpenAI-compatible gateway (Token Harbor, Groq, Together, ...) -----
# Token Harbor (https://tokenharbor.ai): one key for many models; their
# DeepSeek V4 Flash + MiMo V2.5 are free on every account. Keys:
# https://tokenharbor.ai/dashboard/api-keys — then:
#   OPENAI_API_KEY=th-your-token-harbor-key
#   OPENAI_MODEL=<model id from https://tokenharbor.ai/models>
#   OPENAI_BASE_URL=https://api.tokenharbor.ai/v1
# (The openai provider reuses the same OPENAI_* variables; it sends the key
#  as a Bearer token and speaks the OpenAI /chat/completions dialect.)

# --- Local Ollama (optional; also usable as an HTTP peer) --------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# Broker accounts. Mode is `demo` (testnet / paper) by default; `live`
# additionally requires ORION_ALLOW_LIVE_TRADING=true AND an OrionConfig
# with execution_mode="live" and live_trading_enabled=True.
# ---------------------------------------------------------------------------
ORION_ALLOW_LIVE_TRADING=false

# Alpaca (equities/crypto; paper endpoint is free)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_MODE=demo

# Binance (spot; testnet demo by default)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MODE=demo

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_MODE=demo

# Coinbase (Exchange sandbox demo by default)
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=
COINBASE_MODE=demo

# OANDA (fx; practice demo by default)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_MODE=demo

# Interactive Brokers (Client Portal Gateway must run locally)
IBKR_API_HOST=https://localhost:5000
IBKR_ACCOUNT_ID=
IBKR_MODE=demo

# ---------------------------------------------------------------------------
# Web dashboard
# ---------------------------------------------------------------------------
ORION_WEB_HOST=127.0.0.1
ORION_WEB_PORT=8787
